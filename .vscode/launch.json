{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex-Debug: STM32H5 SWO",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "stlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/GPS_Verification.elf",
            "device": "STM32H563RIT6",
            "interface": "swd",
            "runToEntryPoint": "main",
            "swoConfig": {
                "enabled": true,
                "cpuFrequency": 250000000,
                "swoFrequency": 2000000,
                "source": "probe",
                "decoders": [
                    { 
                        "type": "console", 
                        "label": "ITM", 
                        "port": 0 
                    }
                ]
            }
        }
    ]
}